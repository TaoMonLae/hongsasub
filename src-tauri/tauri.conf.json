{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HongsaSub",
  "version": "0.1.0",
  "identifier": "com.taomonlae.hongsasub",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HongsaSub",
        "width": 1480,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/mondict.sqlite": "mondict.sqlite",
      "resources/MonDictDB-LICENSE": "MonDictDB-LICENSE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
